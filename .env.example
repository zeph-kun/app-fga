# Overrides for docker-compose.yml. Copy to `.env` and change every value
# before running this stack anywhere but your own machine — the defaults
# below are public (they're in this file) and grant full access to
# Postgres, Keycloak's admin console, and OpenFGA's API.
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN_PASSWORD=admin
OPENFGA_PRESHARED_KEY=dev-openfga-key
