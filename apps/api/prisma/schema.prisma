generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Who can see or change a Document is not stored here: it lives in OpenFGA.
model Document {
  id         String          @id @default(uuid()) @db.Uuid
  ownerId    String          @map("owner_id")
  // The Folder the Document is in. Not a foreign key: the service checks the Folder exists.
  folderId   String?         @map("folder_id") @db.Uuid
  title      String
  content    String
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  comments   Comment[]
  shareLinks ShareLink[]
  activity   ActivityEntry[]

  @@index([folderId])
  @@map("documents")
}

// Who may read or write Comments is not stored here: it lives in OpenFGA (`can_view`, `can_comment`).
model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  authorId   String   @map("author_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")
  // Deleting a Document deletes its Comments.
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("comments")
}

model Folder {
  id         String          @id @default(uuid()) @db.Uuid
  ownerId    String          @map("owner_id")
  name       String
  // The Folder this one is in. Postgres refuses to delete a Folder that still has Folders in it.
  parentId   String?         @map("parent_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  shareLinks ShareLink[]
  parent     Folder?         @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction)
  children   Folder[]        @relation("FolderTree")
  activity   ActivityEntry[]

  @@index([parentId])
  @@map("folders")
}

// Membership lives in OpenFGA (team:id#member); this is just the name and owner.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

// Exactly one of `documentId` and `folderId` is set (a CHECK in the migration; Prisma cannot declare it).
// Only the hash of the token is kept. Who may create or use a link is not stored here: see ADR 0007.
model ShareLink {
  id          String    @id @default(uuid()) @db.Uuid
  documentId  String?   @map("document_id") @db.Uuid
  folderId    String?   @map("folder_id") @db.Uuid
  role        String
  tokenHash   String    @unique @map("token_hash")
  tokenSuffix String    @map("token_suffix")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  // Deleting a Document or Folder deletes its links.
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([folderId, createdAt])
  @@map("share_links")
}

// One change to who has access to a Document or Folder. Exactly one of `documentId` and `folderId` is
// set (a CHECK in the migration). `details` holds what is particular to `kind`: see ADR 0008.
model ActivityEntry {
  id         String    @id @default(uuid()) @db.Uuid
  documentId String?   @map("document_id") @db.Uuid
  folderId   String?   @map("folder_id") @db.Uuid
  actorId    String    @map("actor_id")
  kind       String
  details    Json
  createdAt  DateTime  @default(now()) @map("created_at")
  // Deleting a Document or Folder deletes its entries.
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([folderId, createdAt])
  @@map("activity_entries")
}
