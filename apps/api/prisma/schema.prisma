generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Who can see or change a Document is not stored here: it lives in OpenFGA.
model Document {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id")
  // The Folder the Document is in. Not a foreign key: the service checks the Folder exists.
  folderId  String?  @map("folder_id") @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  comments  Comment[]

  @@index([folderId])
  @@map("documents")
}

// Who may read or write Comments is not stored here: it lives in OpenFGA (`can_view`, `can_comment`).
model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  authorId   String   @map("author_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")
  // Deleting a Document deletes its Comments.
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("comments")
}

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("folders")
}

// Membership lives in OpenFGA (team:id#member); this is just the name and owner.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}
