generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Who can see or change a Document is not stored here: it lives in OpenFGA.
model Document {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id")
  // The Folder the Document is in. Not a foreign key: the service checks the Folder exists.
  folderId   String?     @map("folder_id") @db.Uuid
  title      String
  content    String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  comments   Comment[]
  shareLinks ShareLink[]

  @@index([folderId])
  @@map("documents")
}

// Who may read or write Comments is not stored here: it lives in OpenFGA (`can_view`, `can_comment`).
model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  authorId   String   @map("author_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")
  // Deleting a Document deletes its Comments.
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("comments")
}

model Folder {
  id         String      @id @default(uuid()) @db.Uuid
  ownerId    String      @map("owner_id")
  name       String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  shareLinks ShareLink[]

  @@map("folders")
}

// Membership lives in OpenFGA (team:id#member); this is just the name and owner.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

// Exactly one of `documentId` and `folderId` is set (a CHECK in the migration; Prisma cannot declare it).
// Only the hash of the token is kept. Who may create or use a link is not stored here: see ADR 0007.
model ShareLink {
  id          String    @id @default(uuid()) @db.Uuid
  documentId  String?   @map("document_id") @db.Uuid
  folderId    String?   @map("folder_id") @db.Uuid
  role        String
  tokenHash   String    @unique @map("token_hash")
  tokenSuffix String    @map("token_suffix")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")
  // Deleting a Document or Folder deletes its links.
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([folderId, createdAt])
  @@map("share_links")
}
